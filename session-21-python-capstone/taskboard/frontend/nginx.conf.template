# Rendered by the nginx image entrypoint (envsubst) from BACKEND_HOST / BACKEND_PORT.
# The upstream is held in a variable and resolved at request time through the container's DNS
# (NGINX_LOCAL_RESOLVERS comes from /etc/resolv.conf), so nginx starts even when the backend
# Service does not exist yet and follows it when its IP changes.
server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;
  set $backend_upstream http://${BACKEND_HOST}:${BACKEND_PORT};

  # Single-page app: unknown paths fall back to index.html.
  location / {
    try_files $uri /index.html;
  }

  # Same-origin API proxy for Docker Compose and for direct access to the frontend Service.
  # Behind the Kubernetes Ingress, /api is routed straight to the backend Service instead.
  location /api/ {
    proxy_pass $backend_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  }

  location /health {
    proxy_pass $backend_upstream/health;
  }

  # Probe endpoint for the frontend container itself; does not depend on the backend.
  location = /healthz {
    add_header Content-Type text/plain;
    return 200 "ok\n";
  }
}
