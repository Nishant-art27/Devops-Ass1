# Copy to terraform.tfvars and adjust. terraform.tfvars is git-ignored; never put AWS keys in here.
aws_region        = "ap-south-1"
environment       = "dev"
cluster_name      = "taskboard-eks"
cluster_version   = "1.31"
vpc_cidr          = "10.20.0.0/16"
azs               = ["ap-south-1a", "ap-south-1b"]
node_instance_types = ["t3.medium"]
node_min_size     = 2
node_max_size     = 4
node_desired_size = 2
